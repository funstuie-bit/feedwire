POSTGRES_PASSWORD=replace-with-a-long-random-password

# AI Provider API Keys (optional - set at least one)
# Keys can also be configured in the Settings page (stored in DB)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# Optional Reddit RSS query credentials (not cookies).
# FeedWire appends these to Reddit URLs; benefit may vary as Reddit changes RSS.
REDDIT_RSS_USER=
REDDIT_RSS_FEED=

# Optional X/Twitter auth_token cookie for RSSHub. Keep this value private.
TWITTER_AUTH_TOKEN=
